app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Firebase Admin service-account keys.
# These grant full read/write access to the whole project and bypass every
# security rule, so they must never reach the repository.
*serviceAccount*.json
*-adminsdk-*.json
/tools/seed/.seeded-*.json
/.firebase-cli-config/

# Local environment files and credentials.
**/.env
**/.env.*
!.env.example
