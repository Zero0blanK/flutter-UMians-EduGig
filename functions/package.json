{
  "name": "student-freelance-backend",
  "version": "2.0.0",
  "description": "Trusted backend for Student Freelance Services: payments held and released, Pro subscriptions, payouts, push",
  "main": "index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "start": "node server.js",
    "serve": "firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "backfill-public-users": "node backfill-public-users.js",
    "test": "node --test smoke.test.js ledger.test.js featured-rotation.test.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "firebase-admin": "^12.3.0",
    "firebase-functions": "^6.1.0"
  },
  "private": true
}
