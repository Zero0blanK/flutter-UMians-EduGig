# Copy to .env and fill in for STANDALONE hosting (node server.js).
# On Cloud Functions the two Xendit values are secrets instead:
#   firebase functions:secrets:set XENDIT_SECRET_KEY
#   firebase functions:secrets:set XENDIT_CALLBACK_TOKEN
# and the rest go in functions/.env (which is deployed, so no secrets there).
# NEVER commit the real values.

# Xendit secret API key. Test keys start with xnd_development_, live with
# xnd_production_. Test mode needs no business activation, so the full flow
# is demoable with Xendit's test payment simulators.
XENDIT_SECRET_KEY=xnd_development_xxxxxxxxxxxxxxxxxxxxxxxx

# Callback verification token from Xendit → Settings → Developers →
# Callbacks. Sent back on every delivery as x-callback-token.
XENDIT_CALLBACK_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx

# Where Xendit returns the buyer after the invoice page.
APP_SUCCESS_URL=https://your-app.example.com/payment/success
APP_CANCEL_URL=https://your-app.example.com/payment/cancelled

# Comma-separated origins allowed to call this service from a browser.
# Required for the Flutter WEB build: without it the browser blocks the
# cross-origin request before it reaches the server. Native builds do not
# need this.
APP_ALLOWED_ORIGINS=https://your-app.example.com,http://localhost:8777

# Payouts: 'auto' sends a requested payout through Xendit Payouts at once
# (needs the Payouts product enabled and a funded balance); anything else
# leaves it in the staff queue for a hand-made transfer.
XENDIT_PAYOUTS=manual
